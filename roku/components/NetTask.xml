<?xml version="1.0" encoding="utf-8"?>
<!-- Talks to the CouchParty server over HTTP long-polling (Roku has no built-in WebSocket). -->
<component name="NetTask" extends="Task">
  <interface>
    <field id="base" type="string" />
    <field id="room" type="string" />
    <field id="key" type="string" alwaysNotify="true" />
    <field id="batch" type="assocarray" alwaysNotify="true" />
    <field id="status" type="string" />
  </interface>
  <script type="text/brightscript" uri="NetTask.brs" />
</component>
